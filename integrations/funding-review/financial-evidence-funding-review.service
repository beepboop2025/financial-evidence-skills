[Unit]
Description=Capture and verify public USD funding evidence
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=financial-evidence
Group=financial-evidence
WorkingDirectory=/opt/financial-evidence-workspace/current
StateDirectory=financial-evidence
StateDirectoryMode=0750
UMask=0027
ExecStart=/usr/bin/python3 /opt/financial-evidence-workspace/current/scripts/capture_funding_review.py --output-dir /var/lib/financial-evidence/funding-review --backend-url https://api.seiche.info/openbb
SuccessExitStatus=1
TimeoutStartSec=240
MemoryMax=192M
CPUQuota=25%
TasksMax=16
Nice=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/financial-evidence


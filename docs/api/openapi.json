    "/api/v1/workflow": {
      "get": {
        "summary": "Workflow",
        "description": "Run one bounded audience workflow, preserving the original product response.",
        "operationId": "workflow_api_v1_workflow_get",
        "parameters": [
          {
            "name": "workflow",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(funding|institutions|exit)$",

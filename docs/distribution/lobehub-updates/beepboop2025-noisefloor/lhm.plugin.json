    {
      "name": "ab_test",
      "title": "Peek-safe A/B verdict",
      "description": "Compare Bernoulli arms with anytime-valid confidence sequences under the stated model assumptions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "a_successes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "a_total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "b_successes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "b_total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "alpha": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "a_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "b_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "a_successes",
          "a_total",
          "b_successes",
          "b_total"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "title": "Peek-safe A/B verdict",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }

  "openapi": "3.1.0",
  "info": {
    "title": "Financial Evidence for OpenBB",
    "description": "Source-cited financial research across LiquiLens, Seiche and Undertow. Public financial-data reads need no API key. Optional installation measurement enrollment and deletion are separate from data access. Preserve source dates, availability, rights and pagination; retrieval success does not validate the evidence.",
    "version": "1.2.0",
    "contact": {
      "name": "LIQUILENS PRIVATE LIMITED",
      "url": "https://beepboop2025.github.io/financial-evidence-skills/support/"
    },
    "termsOfService": "https://beepboop2025.github.io/financial-evidence-skills/terms/"
  },

{
  "cloudEndpoint": "https://api.seiche.info/undertow/mcp",
  "description": "Dated exit evidence, depth, tiers and gold cash scenarios. No executable quotes or trade authority.",
  "homepage": "https://liquilens-undertow.com/",
  "identifier": "beepboop2025-undertow-mcp",
  "name": "Undertow market liquidity map",
  "prompts": [
    {
      "name": "can_this_book_exit",
      "title": "Can this book leave the building?",
      "description": "Unwind stress for the watched books: door width versus position size, margin clock, and what changed this quarter.",
      "arguments": []
    },
    {
      "name": "exit_cost_check",
      "title": "What would selling cost right now?",
      "description": "Venue-by-venue exit cost for a position size, with concentration and consensus-price context and the caveats stated.",
      "arguments": [
        {
          "name": "size_usd",
          "description": "position size in USD (rungs $1k to $1M)",
          "required": false
        }
      ]
    },
    {
      "name": "market_liquidity_briefing",
      "title": "Market liquidity briefing",
      "description": "The full board read: tier per segment, realized depth episodes, and the sealed forward-calls record with misses quoted.",
      "arguments": []
    }
  ],
  "resources": [],
  "tools": [
    {
      "name": "agent_access_status",
      "title": "Your access + meter",
      "description": "Identity, current entitlement, daily usage and access instructions; explains missing/refused subscriber tools.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "title": "Your access + meter",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "crypto_exit_check",
      "title": "Compare crypto exit sizes and freshness",
      "description": "Compare four BTC sell sizes by rung/bracket. Withholds stale/future, uncovered or unconverted venues. Fees excluded; no trade clearance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sizes_usd": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1000000000000
            },
            "default": [
              1000,
              10000,
              100000,
              1000000
            ]
          },
          "max_age_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400,
            "default": 7200
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "title": "Compare crypto exit sizes and freshness",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "crypto_funding_cost",
      "title": "Calculate perpetual funding and fee drag",
      "description": "Caller-input perpetual funding, fees, net carry and linear break-even. Positive funding: longs pay shorts. Constant-rate scenario, not forecast.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "notional_usd": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1000000000000
          },
          "side": {
            "enum": [
              "long",
              "short"
            ]
          },
          "rate_bps_per_settlement": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000,
            "description": "1 bp = 0.01%; positive rate means longs pay shorts."
          },
          "settlements": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "round_trip_fee_bps": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000,
            "default": 0
          }
        },
        "required": [
          "notional_usd",
          "side",
          "rate_bps_per_settlement",
          "settlements"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Calculate perpetual funding and fee drag",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "crypto_portfolio_stress",
      "title": "Stress a crypto portfolio",
      "description": "Caller-input linear shocks for 20 exposures: P&L, equity, asset/venue concentration. Symbols are scenario labels. No liquidation/probability model.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "equity_usd": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1000000000000
          },
          "positions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset",
                "side",
                "notional_usd",
                "price_change_pct"
              ],
              "properties": {
                "asset": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9._-]{0,15}$"
                },
                "venue": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
                },
                "side": {
                  "enum": [
                    "long",
                    "short"
                  ]
                },
                "notional_usd": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1000000000000
                },
                "price_change_pct": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 1000
                },
                "cost_usd": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000,
                  "default": 0
                }
              }
            }
          }
        },
        "required": [
          "equity_usd",
          "positions"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Stress a crypto portfolio",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "depth_episodes",
      "title": "Realized depth collapses",
      "description": "Realized BTC depth-collapse onset, trough, recovery under preregistered rules. Zero is distinct from missing. Subscriber exit_desk_full adds ETH.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "title": "Realized depth collapses",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "exit_cost",
      "title": "Exit cost at your size, per venue",
      "description": "BTC nearest-rung sell estimates, interpolated bid-depth bands; fees excluded, not executable. crypto_exit_check compares sizes/freshness.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "size_usd": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "position size in USD (published rungs run $1,000 to $1,000,000; nearest rung is used)"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "title": "Exit cost at your size, per venue",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "gold_cash_realisation",
      "title": "Gold sale, FX and cash availability scenario",
      "description": "Calculate gold sale proceeds and cash gates from caller inputs. Decimal strings: kg, fineness (0,1], USD/troy-oz bid, USD fees, currency/USD FX (USD=1). Use aware ISO clocks. Returns arithmetic and withheld-cash reasons; no fetch, storage, execution or verified balance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quantity_kg": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "maxLength": 25
          },
          "fineness": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "maxLength": 25
          },
          "bid_usd_per_oz": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "maxLength": 25
          },
          "fees_usd": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "maxLength": 25
          },
          "fx_quote_per_usd": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "maxLength": 25
          },
          "fx_fee_bps": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "maxLength": 25
          },
          "quote_currency": {
            "type": "string",
            "enum": [
              "USD",
              "INR",
              "AED",
              "EUR",
              "GBP",
              "JPY",
              "CHF",
              "SGD"
            ]
          },
          "cutoff": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "quote_asof": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "fx_asof": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "quote_valid_until": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "fx_valid_until": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "settlement_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "cleared": {
            "type": "boolean"
          },
          "access_restricted": {
            "type": "boolean"
          },
          "pledged": {
            "type": "boolean"
          },
          "max_quote_age_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400,
            "default": 900
          }
        },
        "required": [
          "quantity_kg",
          "fineness",
          "bid_usd_per_oz",
          "fees_usd",
          "fx_quote_per_usd",
          "fx_fee_bps",
          "quote_currency",
          "cutoff",
          "quote_asof",
          "fx_asof",
          "quote_valid_until",
          "fx_valid_until",
          "settlement_at",
          "cleared",
          "access_restricted",
          "pledged"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Gold sale, FX and cash availability scenario",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "latest_article",
      "title": "Published editorial",
      "description": "Read the latest published editorial: title, full text, URL, clock and quality receipt. No arguments. Missing text or failed receipt returns an error; no generated prose. Use liquidity_tiers for board data.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "title": "Published editorial",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "liquidity_tiers",
      "title": "Full board: tiers + funding",
      "description": "Nine segment tiers, Seiche funding, measure counts and replay/withholding reasons. PARTIAL means missing history or unpassed replay, never calm.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "title": "Full board: tiers + funding",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "market_corpus_context",
      "title": "Public corpus coverage and source clocks",
      "description": "Inspect corpus coverage, rights and clocks. Summary takes no pagination; other views return records/total/next_offset. Retrieval age is not observation freshness. Use liquidity_tiers for market readings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "enum": [
              "summary",
              "datasets",
              "flows",
              "exports"
            ],
            "default": "summary"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20000,
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 2
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "title": "Public corpus coverage and source clocks",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "research_network",
      "title": "Connected research",
      "description": "Find cross-product source metadata, clocks, rights and next steps. Follow next_offset; unavailable flags retrieval, contract or size failure. Use market_corpus_context for local corpus counts. No shared score or authority.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "all",
              "china",
              "regions",
              "information_controls",
              "model_evaluations",
              "funding",
              "institutions",
              "liquidity",
              "global_data"
            ],
            "default": "all",
            "description": "Catalog topic, not a free-text query."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "default": 0,
            "description": "Zero-based page start; follow next_offset."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 2,
            "description": "Set for full metadata; omission returns 2 compact rows."
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "title": "Connected research",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "sealed_record",
      "title": "Sealed calls record (misses kept)",
      "description": "Forward calls sealed/signed before outcomes: hits, misses, decided counts, ledger root. Report hits and misses together.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "title": "Sealed calls record (misses kept)",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "trade_safety_exit_context",
      "title": "PIT-bound exact-rung paper exit context",
      "description": "Exact-rung BTC/USD observe/paper context: request hash, PIT source/rights, conversion, bid bands, six venue clocks, startup SHA. No live mode or clearance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Opaque complete-request hash"
          },
          "mode": {
            "enum": [
              "observe",
              "paper"
            ]
          },
          "instrument": {
            "const": "BTC/USD"
          },
          "side": {
            "const": "sell"
          },
          "venue": {
            "type": "null"
          },
          "requested_size_usd": {
            "type": "number",
            "enum": [
              1000,
              10000,
              100000,
              1000000
            ],
            "description": "Exact published USD rung"
          }
        },
        "required": [
          "request_hash",
          "mode",
          "instrument",
          "side",
          "venue",
          "requested_size_usd"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "PIT-bound exact-rung paper exit context",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "unwind_watch",
      "title": "Can the watched books exit? (free)",
      "description": "Watched-filer headlines: effective positions, days-to-exit brackets, blind spots. No live execution model. unwind_stress has full scenario grids.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cik": {
            "type": "integer",
            "description": "optional: SEC CIK of a watched filer (returns that filer's full FREE row instead of the all-filer headline)"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "title": "Can the watched books exit? (free)",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "venue_concentration",
      "title": "Depth concentration today",
      "description": "BTC two-sided depth: HHI, effective/top venue and venue depth. Subscriber exit_desk_full adds ETH and venue failure.",
      "inputSchema": {
        "type": "object",
